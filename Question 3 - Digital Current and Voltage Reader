#include <Adafruit_LiquidCrystal.h>

Adafruit_LiquidCrystal lcd(0);
const int sensorPin = A0;
const float loadResistor = 100.0;

void setup() {
  // Setting up the LCD
  lcd.begin(16, 2);
  lcd.setBacklight(1);
  
  lcd.setCursor(0, 0);
  lcd.print("V & I Meter");
  delay(2000);
  lcd.clear();
}

void loop() {
  // Reading the analog value
  int sensorValue = analogRead(sensorPin);
  
  // Converting the analog reading to a voltage
  float voltage = (sensorValue / 1023.0) * 5.0;
  
  // Calculating current using Ohm's Law (I = V / R), multiply by 1000 to get mA
  float current_mA = (voltage / loadResistor) * 1000.0;
  
  // Displaying voltage
  lcd.setCursor(0, 0);
  lcd.print("Volts: ");
  lcd.print(voltage);
  lcd.print(" V  ");
  
  // Displaying Current
  lcd.setCursor(0, 1);
  lcd.print("Curr:  ");
  lcd.print(current_mA, 1); // To one decimal place
  lcd.print(" mA ");
  
  delay(250);
}
